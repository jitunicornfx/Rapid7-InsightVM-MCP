# Copy to .env (git-ignored) or export in your shell. At least one API must be configured.

# --- Security Console API v3 (on-prem) ---
INSIGHTVM_CONSOLE_URL=https://console.example.internal:3780
INSIGHTVM_CONSOLE_USERNAME=api-user
INSIGHTVM_CONSOLE_PASSWORD=change-me
#INSIGHTVM_CONSOLE_2FA_TOKEN=
#INSIGHTVM_CONSOLE_CA_CERT=/path/to/console-ca.pem
#INSIGHTVM_CONSOLE_INSECURE_TLS=0
#INSIGHTVM_CONSOLE_ALLOW_HTTP=0

# --- Insight Platform Cloud Integrations API v4 ---
#INSIGHTVM_API_KEY=
#INSIGHTVM_REGION=us

# --- Behaviour ---
#INSIGHTVM_TIMEOUT_MS=60000
#INSIGHTVM_MAX_RESPONSE_BYTES=5000000
#INSIGHTVM_READ_ONLY=0
#INSIGHTVM_TAGS=
#INSIGHTVM_EXCLUDE_TAGS=
#INSIGHTVM_ALLOW_ADMIN_COMMANDS=0

# --- --http transport ---
#INSIGHTVM_MCP_AUTH_TOKEN=
#INSIGHTVM_HTTP_ALLOWED_ORIGINS=

# --- Updates ---
#INSIGHTVM_DISABLE_UPDATE_CHECK=0
#INSIGHTVM_DISABLE_AUTO_UPDATE=0
