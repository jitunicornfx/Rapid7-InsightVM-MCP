# Copy to .env (git-ignored) or export in your shell. At least one API must be configured.

# --- Security Console API v3 (on-prem) ---
INSIGHTVM_CONSOLE_URL=https://console.example.internal:3780
INSIGHTVM_CONSOLE_USERNAME=api-user
INSIGHTVM_CONSOLE_PASSWORD=change-me
#INSIGHTVM_CONSOLE_2FA_TOKEN=
#INSIGHTVM_CONSOLE_CA_CERT=/path/to/console-ca.pem
#INSIGHTVM_CONSOLE_INSECURE_TLS=0
#INSIGHTVM_ALLOW_HTTP=0

# --- Insight Platform Cloud Integrations API v4 ---
#INSIGHTVM_API_KEY=
#INSIGHTVM_REGION=us

# --- Behaviour ---
#INSIGHTVM_TIMEOUT_MS=60000

# --- Result size (see README "Large results") ---
# Characters of API data one tool result may carry (~50k tokens). The model-context budget.
#INSIGHTVM_MAX_RESULT_CHARS=200000
# Memory guard on the wire only; must stay well above the largest complete response.
#INSIGHTVM_MAX_RESPONSE_BYTES=16777216
# 1 keeps the per-record HATEOAS links that are stripped by default.
#INSIGHTVM_KEEP_RECORD_LINKS=0
# 'size' injected when a paged tool is called without one; clamped to 500.
#INSIGHTVM_DEFAULT_PAGE_SIZE=100

# --- insightvm_export_to_file ---
#INSIGHTVM_SPOOL_DIR=
#INSIGHTVM_SPOOL_RETENTION_HOURS=24
# 1 removes the export tool, the only tool that writes to the local filesystem.
#INSIGHTVM_DISABLE_EXPORT=0
#INSIGHTVM_READ_ONLY=0
#INSIGHTVM_TAGS=
#INSIGHTVM_EXCLUDE_TAGS=
#INSIGHTVM_ALLOW_ADMIN_COMMANDS=0

# --- --http transport ---
#INSIGHTVM_MCP_AUTH_TOKEN=
#INSIGHTVM_HTTP_ALLOWED_ORIGINS=

# --- Updates ---
#INSIGHTVM_DISABLE_UPDATE_CHECK=0
#INSIGHTVM_DISABLE_AUTO_UPDATE=0
